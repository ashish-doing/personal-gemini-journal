rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only ever read/write documents under their own uid.
    // This is enforced server-side by Firestore itself — the client SDK
    // has no special privilege, so a modified/malicious client still
    // cannot read another user's sessions.
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

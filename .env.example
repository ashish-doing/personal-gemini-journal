# Local dev only. Never committed (see .gitignore). Production uses Secret Manager instead.
PORT=8080

# Option A (local dev shortcut): paste your AI Studio key directly. Do NOT use in production.
GEMINI_API_KEY=

# Option B (matches production path): point at a Secret Manager resource instead of the raw key.
# GEMINI_API_KEY_SECRET_NAME=projects/YOUR_PROJECT_ID/secrets/gemini-api-key/versions/latest

# Optional override, defaults to gemini-2.0-flash in code.
# GEMINI_MODEL=gemini-2.0-flash
